FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir .

EXPOSE 8501

CMD ["sh", "-c", "python -m streamlit run app/ui/streamlit_app.py --server.address 0.0.0.0 --server.port ${PORT:-8501}"]